# Database container settings. Use a long random password in production.
POSTGRES_DB=spliit
POSTGRES_USER=spliit
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# API runtime settings.
WEB_ORIGINS=https://your-cloudflare-pages-domain.pages.dev
PUBLIC_DEFAULT_CURRENCY_CODE=

# Expense document uploads.
PUBLIC_ENABLE_EXPENSE_DOCUMENTS=false
S3_UPLOAD_KEY=
S3_UPLOAD_SECRET=
S3_UPLOAD_BUCKET=spliit-prod-uploads
S3_UPLOAD_REGION=auto
S3_UPLOAD_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_UPLOAD_PUBLIC_URL=https://uploads.spliit.cloud

# Optional AI features. Leave disabled unless configured.
PUBLIC_ENABLE_RECEIPT_EXTRACT=false
PUBLIC_ENABLE_CATEGORY_EXTRACT=false
AI_PROVIDER=openai
AI_API_KEY=
# API root. The selected provider appends its own endpoint path.
AI_BASE_URL=
AI_RECEIPT_MODEL=gpt-5-nano
AI_CATEGORY_MODEL=gpt-5-nano

# Better Auth (required in production: BETTER_AUTH_SECRET).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.your-domain.com

# Optional: Google OAuth (leave empty to disable).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: GitHub OAuth (leave empty to disable). When configuring the OAuth
# app, set the callback URL to `${BETTER_AUTH_URL}/auth/callback/github`.
# For local dev with the web on port 3000 and API on port 3001, that is
# typically `http://localhost:3001/auth/callback/github`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP (required in production: SMTP_HOST). Used for magic-link auth and
# group sync invitations. Examples:
#   Gmail:     smtp.gmail.com / 587 / your-gmail / app-password
#   SendGrid:  smtp.sendgrid.net / 587 / apikey / your-api-key
#   Mailgun:   smtp.mailgun.org / 587 / postmaster@yourdomain.com / smtp-pass
#   Postmark:  smtp.postmarkapp.com / 587 / server-token / server-token
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Required in production. The "From" header on every outgoing email.
EMAIL_FROM="Spliit Cloud <noreply@yourdomain.com>"

# Web Push (required together in production). Generate with
# `bunx web-push generate-vapid-keys`; keep the private key secret.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@yourdomain.com

# Stateless optional-email unsubscribe links. Generate with:
#   openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=

# Background jobs.
JOBS_ENABLED=true
JOBS_RECONCILIATION_CRON=* * * * *
JOBS_MAX_CONCURRENCY=5
JOBS_POOL_SIZE=8
JOBS_RETRY_LIMIT=5
JOBS_RETRY_BACKOFF_SECONDS=30
JOBS_RETENTION_SECONDS=604800
PGBOSS_SCHEMA=pgboss
