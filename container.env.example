# Image and host-port settings.
# SPLIIT_TAG follows stable releases: pin a version (SPLIIT_TAG=v2.0.0)
# for controlled upgrades, or use `latest` to follow the newest stable.
SPLIIT_TAG=latest
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# The one public HTTPS origin served by your reverse proxy.
# Canonical form has no trailing slash; a trailing slash is tolerated and
# stripped with a startup warning (it used to break invite links, see #120).
APP_URL=https://spliit.example.com
# Split-origin deployments only: set these to the public web and API origins.
# Leave both empty for the normal same-origin setup.
WEB_ORIGINS=
BETTER_AUTH_URL=
# Enable only after the origin is restricted to trusted proxy traffic. A direct
# caller can spoof forwarded client-IP headers while the origin is public.
TRUST_PROXY=false

# PostgreSQL. Generate a long random password and back up the Docker volume.
POSTGRES_DB=spliit
POSTGRES_USER=spliit
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Email sign-in (password + magic link). Enabled by default. Set to false for
# SSO-only instances (OIDC or social login): the email form is hidden, email
# sign-in endpoints are rejected, and SMTP below becomes optional. Requires at
# least one SSO provider or the API refuses to start (lockout guard).
ENABLE_EMAIL_AUTH=true

# SMTP is required in production when ENABLE_EMAIL_AUTH=true (sign-in links,
# verification, recovery, and invitations). With ENABLE_EMAIL_AUTH=false it is
# optional: email invitations still create DB rows and appear in-app (friends
# auto-join on SSO sign-in, groups accept from the pending list), but no email
# is delivered — tell invitees to sign in via SSO or share a link invite.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set both for authenticated SMTP, or leave both empty for a trusted relay.
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Spliit Cloud <noreply@example.com>

# Signs notification unsubscribe links. Generate with: openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=

# Instance defaults.
PUBLIC_DEFAULT_CURRENCY_CODE=USD

# Optional Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub OAuth.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional X (Twitter) OAuth. Use the OAuth 2.0 Client ID and Client Secret.
# Callback: {BETTER_AUTH_URL}/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Optional generic OpenID Connect login (any OIDC IdP).
# Register the callback URL at your IdP:
#   {BETTER_AUTH_URL}/auth/callback/{OIDC_PROVIDER_ID}
# Default callback slug is `oidc`. DISPLAY_NAME is the sign-in button label.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_DISPLAY_NAME=
OIDC_PROVIDER_ID=

# Optional S3-compatible expense-document storage.
PUBLIC_ENABLE_EXPENSE_DOCUMENTS=false
S3_UPLOAD_KEY=
S3_UPLOAD_SECRET=
S3_UPLOAD_BUCKET=
S3_UPLOAD_REGION=
S3_UPLOAD_ENDPOINT=
S3_UPLOAD_PUBLIC_URL=
# Maximum expense attachment size in megabytes (default 2, max 50). Uploads go
# directly to S3, but larger values increase memory use during exports.
MAX_EXPENSE_DOCUMENT_SIZE_MB=2

# Optional AI features.
PUBLIC_ENABLE_RECEIPT_EXTRACT=false
PUBLIC_ENABLE_VOICE_EXPENSE=false
PUBLIC_ENABLE_CATEGORY_EXTRACT=false
PUBLIC_ENABLE_BULK_CATEGORIZE=false
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_RECEIPT_MODEL=gpt-5-nano
AI_CATEGORY_MODEL=gpt-5-nano
AI_VOICE_MODEL=
# Per-feature AI provider timeouts in seconds. Raise these when self-hosting a
# slow model so receipt/voice scans wait longer instead of timing out.
AI_RECEIPT_TIMEOUT_SECONDS=120
AI_VOICE_TIMEOUT_SECONDS=120
AI_CATEGORY_TIMEOUT_SECONDS=30
AI_CATEGORY_RECENT_EXPENSES_LIMIT=50
# Single-expense category AI engine: llm (default) or system-one (a System One
# decision model — TypeSafe's Jev by default). The system-one engine
# additionally requires AI_SYSTEM_ONE_API_KEY (server-side only).
AI_CATEGORY_ENGINE=llm
AI_SYSTEM_ONE_API_KEY=
AI_SYSTEM_ONE_MODEL=jev-latest
AI_SYSTEM_ONE_TIMEOUT_SECONDS=10
# Decision-model endpoint. Defaults to TypeSafe; point at a self-hosted
# /v1/systemone-compatible server (e.g. Kev) to run another model.
AI_SYSTEM_ONE_BASE_URL=https://api.typesafe.ai/v1/systemone
# Minimum AI confidence (0-1) for a suggestion, whichever engine runs (System
# One: model confidence; LLM: self-reported confidence). Below it degrades to none.
# Default 0.5 is a conservative starting point; calibrate on labeled expenses.
AI_CATEGORY_MIN_CONFIDENCE=0.5
# Local suggest stages (both default true) and local-matcher gates. The web
# client mirrors the switches, so both layers agree on which stages run.
CATEGORY_DICTIONARY_ENABLED=true
CATEGORY_HISTORY_ENABLED=true
CATEGORY_LOCAL_MIN_SCORE=0.8
CATEGORY_LOCAL_SETTLEMENT_MIN_SCORE=0.95
# Local title→category memory size (not sent to the LLM). Cheap; 100–500 is fine.
CATEGORY_MEMORY_LIMIT=200

# Optional Web Push. Configure all three values or leave all three empty.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=

# Optional MCP/assistant API. The MCP service is deployed separately.
ENABLE_MCP=false
MCP_PUBLIC_URL=
# Required and at least 32 bytes only when ENABLE_MCP=true.
ASSISTANT_CONFIRMATION_SECRET=

# Account registration. `open` (default) lets anyone create an account.
# `invite_only` restricts sign-up to the first user on a fresh instance,
# people with a pending group/friend email invitation, or visitors who
# open a live share-link invite. Recommended for private self-hosted
# instances.
SIGNUP_MODE=open

# Android TWA (Trusted Web Activity) identity. Leave both empty when no
# store app is published; `/.well-known/assetlinks.json` then 404s.
# TWA_PACKAGE_NAME is the Play application ID (e.g. com.example.spliit).
# TWA_SHA256_FINGERPRINTS is comma-separated; list the upload-key and the
# Play App-signing SHA-256 fingerprints together (keytool output with or
# without colons is accepted).
TWA_PACKAGE_NAME=
TWA_SHA256_FINGERPRINTS=

# Optional anonymous accounts with persistent recovery keys. In invite-only
# mode, new anonymous accounts require a live group share-link invite.
ENABLE_ANONYMOUS_AUTH=false

# Background worker.
JOBS_ENABLED=true
# Allow webhook endpoints on HTTP/private networks. Keep false on public hosts.
WEBHOOK_ALLOW_PRIVATE_ENDPOINTS=false
# Optional Cloudflare Worker relay so destinations never see the server IP
# (see docs/webhooks.md "Relay mode"). Set both or neither, on api and worker.
# Cannot be combined with WEBHOOK_ALLOW_PRIVATE_ENDPOINTS=true.
WEBHOOK_RELAY_URL=
WEBHOOK_RELAY_SECRET=
JOBS_RECONCILIATION_CRON=*/30 * * * *
JOBS_NOTIFICATION_RECONCILE_CRON=*/15 * * * *
JOBS_MAX_CONCURRENCY=1
JOBS_POLLING_INTERVAL_SECONDS=60
JOBS_MAINTENANCE_POLLING_INTERVAL_SECONDS=300
JOBS_POOL_SIZE=8
JOBS_RETRY_LIMIT=5
JOBS_RETRY_BACKOFF_SECONDS=30
JOBS_RETENTION_SECONDS=604800
