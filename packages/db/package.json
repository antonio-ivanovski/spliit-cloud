{
  "name": "@spliit/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dmmf": "./src/dmmf.ts"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "prisma-migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma-create-migration": "prisma migrate dev",
    "prisma-generate": "prisma generate --schema prisma/schema.prisma",
    "test": "vitest run --globals src"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "^7.8.0",
    "@spliit/domain": "workspace:*",
    "dotenv": "^17.4.2",
    "pg": "8.22.0",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@spliit/config": "workspace:*",
    "@types/node": "24.13.2",
    "@types/pg": "^8.20.0",
    "prisma-json-types-generator": "^5.1.0",
    "prisma-mock": "^1.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0-beta.5"
  }
}
