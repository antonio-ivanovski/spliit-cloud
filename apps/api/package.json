{
  "name": "@spliit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": "./src/trpc/routers/_app.ts",
    "./app": "./src/app.ts",
    "./server": "./src/server.ts",
    "./lib/api/activities": "./src/lib/api/activities.ts",
    "./lib/api/recurrence-series": "./src/lib/api/recurrence-series.ts",
    "./lib/notifications/delivery-repository": "./src/lib/notifications/delivery-repository.ts",
    "./lib/notifications/delivery-senders": "./src/lib/notifications/delivery-senders.ts",
    "./lib/notifications/delivery-snapshot": "./src/lib/notifications/delivery-snapshot.ts",
    "./lib/notifications/delivery-cleanup": "./src/lib/notifications/delivery-cleanup.ts",
    "./lib/notifications/delivery-reconciliation": "./src/lib/notifications/delivery-reconciliation.ts",
    "./lib/notifications/delivery-planner": "./src/lib/notifications/delivery-planner.ts",
    "./lib/notifications/email-delivery-sender": "./src/lib/notifications/email-delivery-sender.ts",
    "./lib/notifications/push-delivery-sender": "./src/lib/notifications/push-delivery-sender.ts",
    "./lib/notifications/dispatcher": "./src/lib/notifications/dispatcher.ts",
    "./lib/budgets/evaluate": "./src/lib/budgets/evaluate.ts",
    "./lib/notifications/budget-planner": "./src/lib/notifications/budget-planner.ts"
  },
  "scripts": {
    "check-formatting": "oxfmt --check .",
    "check-types": "tsc --noEmit",
    "dev": "bun --env-file=../../.env --watch src/server.ts",
    "email": "email dev --dir src/lib/mail/templates --port 3002",
    "format": "oxfmt .",
    "generate-openapi": "bun run scripts/generate-openapi.ts",
    "lint": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives --fix .",
    "start": "bun --env-file=../../.env run src/server.ts",
    "start:integration": "bun --env-file=.env.integration run src/server.ts",
    "test": "bun --env-file=.env.test vitest run --globals src",
    "test:integration": "bun --env-file=.env.integration vitest run --config vitest.integration.config.ts --reporter=verbose"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.11",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@better-auth/oauth-provider": "^1.6.25",
    "@json2csv/plainjs": "^7.0.6",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.10",
    "@scalar/hono-api-reference": "^0.11.9",
    "@spliit/db": "workspace:*",
    "@spliit/domain": "workspace:*",
    "@spliit/jobs": "workspace:*",
    "@trpc/openapi": "11.18.0-alpha",
    "@trpc/server": "^11.18.0",
    "ai": "^7.0.20",
    "better-auth": "^1.6.25",
    "content-disposition": "^2.0.1",
    "hono": "^4.12.27",
    "jose": "^6.2.4",
    "nanoid": "^5.1.16",
    "nodemailer": "^9.0.3",
    "openapi-types": "^12.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-email": "^6.6.8",
    "superjson": "^2.2.6",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "^6.6.8",
    "@spliit/config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/content-disposition": "^0.5.9",
    "@types/node": "24.13.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "nodemailer-mock": "^2.0.13",
    "prisma-mock": "^1.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0-beta.7",
    "vitest-mock-extended": "^5.1.0"
  }
}
