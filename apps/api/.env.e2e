# E2E-test environment defaults.
# Loaded by the `@spliit/api#start:e2e` script via Bun's `--env-file` flag,
# then exercised with `bun --filter @spliit/web test:e2e` (no extra env vars;
# the Playwright config defaults to this API origin and web port).
# Requires MailDev running on localhost:1080 (web) / 1025 (SMTP) and a migrated
# Postgres on localhost:5432. Start both with `bun dev:up`.
#
# Same PORT as .env.integration on purpose (both profiles mirror a plain-port
# production-like API); run only one of `start:integration` / `start:e2e` at
# a time. The difference is WEB_ORIGINS: e2e drives a real Chromium at
# http://localhost:5173 (Playwright's webServer), which must pass the API's
# CORS and better-auth trusted-origin checks. See apps/web/playwright.config.ts.

DATABASE_URL=postgresql://postgres:1234@localhost
BETTER_AUTH_SECRET=spliit-test-secret
BETTER_AUTH_URL=http://localhost:3101
PORT=3101
NODE_ENV=test
WEB_ORIGINS=http://localhost:5173
# Anonymous guest signup is the e2e suite's only auth path (every test signs
# up a fresh guest). TRUST_PROXY is required alongside it by env validation.
ENABLE_ANONYMOUS_AUTH=true
TRUST_PROXY=true
# The suite burns several anon signups per run (setup + anon spec + retries
# during development); the production default of 10/hour would rate-limit
# local iteration into failure. 1000 keeps an abuse brake while giving
# headroom. Production keeps the default 10.
ANONYMOUS_SIGNUP_RATE_LIMIT_PER_HOUR=1000
# Disable passkey UI so anonymous creation deterministically continues on the
# complete-profile page (display name, then recovery-link safeguard) instead
# of branching into the in-dialog passkey flow. Passkey UI stays covered by
# unit tests (CompleteProfilePage/AuthPanel).
ENABLE_PASSKEY_AUTH=false
ENABLE_MCP=true
MCP_PUBLIC_URL=http://localhost:3002
ASSISTANT_CONFIRMATION_SECRET=spliit-test-assistant-secret-32-bytes

# disable the worker (if online), messes up the test environment with async jobs
JOBS_ENABLED=false

S3_UPLOAD_BUCKET=spliit-local
S3_UPLOAD_KEY=maxioadmin
S3_UPLOAD_SECRET=maxioadmin
S3_UPLOAD_REGION=us-east-1
S3_UPLOAD_ENDPOINT=http://localhost:9000
S3_UPLOAD_PUBLIC_URL=http://localhost:9000/spliit-local
PUBLIC_ENABLE_EXPENSE_DOCUMENTS=true

GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret
TWITTER_CLIENT_ID=test-twitter-client-id
TWITTER_CLIENT_SECRET=test-twitter-client-secret

# MailDev (local SMTP capture for e2e tests).
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Spliit Test <no-reply@test.local>
