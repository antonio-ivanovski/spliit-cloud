# Unit-test environment defaults.
# Loaded by the `@spliit/api#test` script via Bun's `--env-file` flag.
# Intentionally omits SMTP_* so env-validation tests can assert "missing".

DATABASE_URL=postgresql://postgres:1234@localhost
BETTER_AUTH_SECRET=spliit-test-secret
BETTER_AUTH_URL=http://localhost:3001
NODE_ENV=test
WEB_ORIGINS=http://localhost:3000
ENABLE_MCP=true
MCP_PUBLIC_URL=http://localhost:3002
ASSISTANT_CONFIRMATION_SECRET=spliit-test-assistant-secret-32-bytes

# S3 (upload route otherwise short-circuits with 503).
S3_UPLOAD_BUCKET=spliit-test-bucket
S3_UPLOAD_KEY=AKIA-TEST
S3_UPLOAD_REGION=us-east-1
S3_UPLOAD_SECRET=test-secret
S3_UPLOAD_ENDPOINT=

# Social providers — auth tests inspect the config, real values are never exchanged.
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret
TWITTER_CLIENT_ID=test-twitter-client-id
TWITTER_CLIENT_SECRET=test-twitter-client-secret
