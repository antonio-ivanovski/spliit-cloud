# Integration-test environment defaults.
# Loaded by apps/api/vitest.integration.config.ts via vite's `loadEnv('integration', ...)`.
# Requires MailDev running on localhost:1080 (web) / 1025 (SMTP) and a migrated
# Postgres on localhost:5432. See packages/dev-services/package.json.

DATABASE_URL=postgresql://postgres:1234@localhost
BETTER_AUTH_SECRET=spliit-test-secret
BETTER_AUTH_URL=http://localhost:3001
NODE_ENV=test
WEB_ORIGINS=http://localhost:3000

S3_UPLOAD_BUCKET=spliit-test-bucket
S3_UPLOAD_KEY=AKIA-TEST
S3_UPLOAD_REGION=us-east-1
S3_UPLOAD_SECRET=test-secret
S3_UPLOAD_ENDPOINT=

GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret

# MailDev (local SMTP capture for integration tests).
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Spliit Test <no-reply@test.local>