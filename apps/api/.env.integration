# Integration-test environment defaults.
# Loaded by both the `@spliit/api#test:integration` and
# `@spliit/api#start:integration` scripts via Bun's `--env-file` flag.
# Requires MailDev running on localhost:1080 (web) / 1025 (SMTP) and a migrated
# Postgres on localhost:5432. Start both with `bun dev:up`.

DATABASE_URL=postgresql://postgres:1234@localhost
BETTER_AUTH_SECRET=spliit-test-secret
BETTER_AUTH_URL=http://localhost:3101
PORT=3101
NODE_ENV=test
WEB_ORIGINS=http://localhost:3000
ENABLE_MCP=true
MCP_PUBLIC_URL=http://localhost:3002
ASSISTANT_CONFIRMATION_SECRET=spliit-test-assistant-secret-32-bytes

# disable the worker (if online), messes up the test environment with async jobs
JOBS_ENABLED=false

S3_UPLOAD_BUCKET=spliit-local
S3_UPLOAD_KEY=maxioadmin
S3_UPLOAD_SECRET=maxioadmin
S3_UPLOAD_REGION=us-east-1
S3_UPLOAD_ENDPOINT=http://localhost:9000
S3_UPLOAD_PUBLIC_URL=http://localhost:9000/spliit-local
PUBLIC_ENABLE_EXPENSE_DOCUMENTS=true

GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret
TWITTER_CLIENT_ID=test-twitter-client-id
TWITTER_CLIENT_SECRET=test-twitter-client-secret

# MailDev (local SMTP capture for integration tests).
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Spliit Test <no-reply@test.local>
