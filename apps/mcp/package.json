{
  "name": "@spliit/mcp",
  "version": "1.0.0",
  "description": "Spliit Cloud assistant for ChatGPT and Claude",
  "keywords": [
    "apps-sdk",
    "mcp",
    "mcp-ui",
    "prompts",
    "react",
    "resources",
    "server",
    "starter",
    "tools",
    "ui",
    "uiresource",
    "widgets"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "if [ -f ../../.env ]; then bun --env-file=../../.env run build:server; else bun run build:server; fi",
    "build:server": "mcp-use build",
    "check-formatting": "oxfmt --check .",
    "check-types": "tsc --noEmit",
    "deploy": "mcp-use deploy",
    "dev": "bun --env-file=../../.env run dev:server",
    "dev:server": "mcp-use dev --port 3002 --no-open",
    "format": "oxfmt .",
    "lint": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives --fix .",
    "postinstall": "mcp-use generate-types || true",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@trpc/client": "11.18.0",
    "jose": "^6.2.4",
    "mcp-use": "^1.34.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "superjson": "2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@spliit/config": "workspace:*",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite": "^8.1.2",
    "vitest": "5.0.0-beta.5"
  }
}
