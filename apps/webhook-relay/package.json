{
  "name": "@spliit/webhook-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-formatting": "oxfmt --check .",
    "check-types": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev:relay": "portless relay.spliit wrangler dev --port ${PORT:-8787}",
    "dev:relay:app": "wrangler dev --port ${PORT:-8787}",
    "format": "oxfmt .",
    "lint": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives --fix .",
    "test": "vitest run src"
  },
  "devDependencies": {
    "@spliit/config": "workspace:*",
    "@types/node": "^24.13.2",
    "typescript": "7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "portless": {
    "name": "relay.spliit",
    "script": "dev:relay:app"
  }
}
