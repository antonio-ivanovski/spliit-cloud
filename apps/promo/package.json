{
  "name": "@spliit/promo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "browser:install": "playwright install chromium",
    "build": "vite build",
    "check-formatting": "oxfmt --check .",
    "check-types": "tsc --noEmit",
    "format": "oxfmt .",
    "lint": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --format=unix --report-unused-disable-directives --fix .",
    "narration": "bun scripts/narration.ts",
    "narration:setup": "bun scripts/narration.ts --setup",
    "preview": "vite preview --host 127.0.0.1",
    "render": "bun scripts/render.ts",
    "render:poster": "bun scripts/render-video.ts poster",
    "render:video": "bun scripts/render-video.ts video",
    "sound-design": "bun scripts/sound-design.ts",
    "sound-design:setup": "bun scripts/sound-design.ts --setup",
    "studio": "remotionb studio src/video/index.tsx",
    "test": "bun test ./src/catalog.test.ts ./scripts/render-video.test.ts",
    "test:export": "bun test ./scripts/export.test.ts ./scripts/sound-design.export.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@remotion/tailwind-v4": "4.0.535",
    "@spliit/domain": "workspace:*",
    "@spliit/web": "workspace:*",
    "i18next": "^26.4.2",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@spliit/config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@types/node": "24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.0"
  }
}
