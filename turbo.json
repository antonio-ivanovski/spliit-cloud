{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "ci-checks": {
      "dependsOn": [
        "//#check-formatting:root",
        "check-formatting",
        "lint",
        "check-types",
        "i18n",
        "build",
        "generate-openapi",
        "test",
        "test:integration"
      ]
    },
    "build": {
      "dependsOn": ["^build", "check-types", "@spliit/db#prisma-generate"],
      "outputs": ["dist/**", "build/**", ".vite/**"]
    },
    "dev": {
      "dependsOn": ["@spliit/db#prisma-generate"],
      "cache": false,
      "persistent": true
    },
    "dev:mcp": {
      "dependsOn": ["@spliit/db#prisma-generate"],
      "cache": false,
      "persistent": true
    },
    "dev:relay": {
      "cache": false,
      "persistent": true
    },
    "prisma-generate": {
      "inputs": [
        "prisma/schema.prisma",
        "prisma.config.ts",
        "package.json",
        "$TURBO_ROOT$/bun.lock"
      ],
      "outputs": ["src/generated/prisma/**"]
    },
    "prisma-migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "lint": {
      "dependsOn": ["@spliit/db#prisma-generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/packages/config/tsconfig.base.json"
      ]
    },
    "lint:fix": {
      "dependsOn": ["@spliit/db#prisma-generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/packages/config/tsconfig.base.json"
      ],
      "cache": false
    },
    "check-formatting": {
      "inputs": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,yaml,yml,toml,html,css,scss,less,md,mdx,graphql,gql}",
        "!src/routeTree.gen.ts",
        "!src/components/ui/**",
        "!src/generated/**",
        "$TURBO_ROOT$/oxfmt.config.ts",
        "$TURBO_ROOT$/package.json"
      ]
    },
    "format": {
      "cache": false,
      "inputs": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,json5,yaml,yml,toml,html,css,scss,less,md,mdx,graphql,gql}",
        "!src/routeTree.gen.ts",
        "!src/components/ui/**",
        "!src/generated/**",
        "$TURBO_ROOT$/oxfmt.config.ts",
        "$TURBO_ROOT$/package.json"
      ]
    },
    "//#check-formatting:root": {
      "inputs": [
        "oxfmt.config.ts",
        "lefthook.yml",
        ".oxlintrc.json",
        "package.json",
        "turbo.json",
        "*.md",
        ".devcontainer/**",
        ".github/**",
        "docs/**",
        "handoff/**",
        "compose*.yaml",
        "doctor.config.json"
      ]
    },
    "//#format:root": {
      "cache": false,
      "inputs": [
        "oxfmt.config.ts",
        "lefthook.yml",
        ".oxlintrc.json",
        "package.json",
        "turbo.json",
        "*.md",
        ".devcontainer/**",
        ".github/**",
        "docs/**",
        "handoff/**",
        "compose*.yaml",
        "doctor.config.json"
      ]
    },
    "check-types": {
      "dependsOn": ["@spliit/db#prisma-generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/config/tsconfig.base.json"
      ]
    },
    "i18n": {},
    "generate-openapi": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"],
      "outputs": ["openapi.json"]
    },
    "test": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"],
      "outputs": ["coverage/**", ".vitest/**"]
    },
    "test:integration": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"],
      "cache": false,
      "passThroughEnv": ["E2E_API_URL", "E2E_BASE_URL", "E2E_WEB_PORT", "CI"]
    }
  }
}
