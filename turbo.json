{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "ci-checks": {
      "dependsOn": [
        "check-formatting",
        "lint",
        "check-types",
        "i18n",
        "build",
        "generate-openapi",
        "test",
        "test:integration"
      ]
    },
    "build": {
      "dependsOn": ["^build", "check-types", "@spliit/db#prisma-generate"],
      "outputs": ["dist/**", "build/**", ".vite/**"]
    },
    "dev": {
      "dependsOn": ["@spliit/db#prisma-generate"],
      "cache": false,
      "persistent": true
    },
    "prisma-generate": {
      "cache": false
    },
    "prisma-migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "lint": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"]
    },
    "check-formatting": {},
    "check-types": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"]
    },
    "i18n": {},
    "generate-openapi": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"],
      "outputs": ["openapi.json"]
    },
    "test": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build", "@spliit/db#prisma-generate"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
