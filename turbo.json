{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "check-types"],
      "outputs": ["dist/**", "build/**", ".vite/**"]
    },
    "dev": {
      "dependsOn": ["@spliit/db#prisma-generate", "@spliit/db#prisma-migrate"],
      "with": [
        "@spliit/dev-services#dev:services:maxio",
        "@spliit/dev-services#dev:services:maildev"
      ],
      "cache": false,
      "persistent": true
    },
    "dev:services:db:up": {
      "cache": false
    },
    "dev:services:db": {
      "cache": false,
      "persistent": true
    },
    "dev:services:maxio": {
      "cache": false,
      "persistent": true
    },
    "dev:services:maildev": {
      "cache": false,
      "persistent": true
    },
    "prisma-generate": {
      "cache": false
    },
    "prisma-migrate": {
      "dependsOn": ["@spliit/dev-services#dev:services:db:up"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test-e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
