DATABASE_URL=postgresql://postgres:1234@localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=postgres

PUBLIC_DEFAULT_CURRENCY_CODE=""
VITE_DEFAULT_CURRENCY_CODE=""
VITE_API_URL="http://localhost:3001"

# Local object storage (MaxIO)
PUBLIC_ENABLE_EXPENSE_DOCUMENTS=true
MAXIO_PORT=9000
MAXIO_ACCESS_KEY=maxioadmin
MAXIO_SECRET_KEY=maxioadmin
MAXIO_DEFAULT_BUCKETS=spliit-local
MAXIO_REGION=us-east-1
S3_UPLOAD_BUCKET=spliit-local
S3_UPLOAD_KEY=maxioadmin
S3_UPLOAD_SECRET=maxioadmin
S3_UPLOAD_REGION=us-east-1
S3_UPLOAD_ENDPOINT="http://localhost:9000"
S3_UPLOAD_PUBLIC_URL="http://localhost:9000/spliit-local"

# Local email capture (MailDev)
MAILDEV_WEB_PORT=1080
MAILDEV_SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Spliit Local <no-reply@spliit.local>"
