BETTER_AUTH_SECRET=spliit-test-secret

DATABASE_URL=postgresql://postgres:1234@localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=postgres

# Prisma connection pool (per process).
# total PostgreSQL connections =
#   API replicas × (API Prisma pool + API pg-boss pool)
#   + worker replicas × (worker Prisma pool + worker pg-boss pool)
#   + migration and administrative reserve
DATABASE_POOL_SIZE=10
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=5000
DATABASE_TRANSACTION_MAX_WAIT_MS=2000
DATABASE_TRANSACTION_TIMEOUT_MS=5000
DATABASE_APPLICATION_NAME=spliit

PUBLIC_DEFAULT_CURRENCY_CODE="USD"
VITE_DEFAULT_CURRENCY_CODE="USD"
VITE_API_URL="http://localhost:3001"

# General Spliit local-development settings. Keep these on localhost when
# using the app and Inspector locally.
# When connecting ChatGPT or Claude, temporarily replace these three values
# with the public API/web tunnel URLs shown below as well.
BETTER_AUTH_URL="http://localhost:3001"
WEB_ORIGINS="http://localhost:3000"

# MCP-only settings. The MCP server uses these values to reach the public
# OAuth/API/web origins. Localhost defaults keep `bun dev` and the Inspector
# working out of the box.
# ChatGPT and Claude cannot reach localhost. To connect them, start one tunnel
# per local service and replace each value below with the HTTPS URL it prints:
#   cloudflared tunnel --url http://localhost:3002  # MCP
#   cloudflared tunnel --url http://localhost:3001  # API
#   cloudflared tunnel --url http://localhost:3000  # Web
MCP_PUBLIC_URL="http://localhost:3002"
MCP_API_URL="http://localhost:3001"
MCP_WEB_URL="http://localhost:3000"
# API-only: encrypts assistant confirmation tokens. Never share with MCP or
# reuse BETTER_AUTH_SECRET. Generate with: openssl rand -hex 32
ASSISTANT_CONFIRMATION_SECRET=

# Local object storage (MaxIO)
PUBLIC_ENABLE_EXPENSE_DOCUMENTS=true
MAXIO_PORT=9000
MAXIO_ACCESS_KEY=maxioadmin
MAXIO_SECRET_KEY=maxioadmin
MAXIO_DEFAULT_BUCKETS=spliit-local
MAXIO_REGION=us-east-1
S3_UPLOAD_BUCKET=spliit-local
S3_UPLOAD_KEY=maxioadmin
S3_UPLOAD_SECRET=maxioadmin
S3_UPLOAD_REGION=us-east-1
S3_UPLOAD_ENDPOINT="http://localhost:9000"
S3_UPLOAD_PUBLIC_URL="http://localhost:9000/spliit-local"

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Spliit Cloud Local <no-reply@spliit.local>"

# Web Push (generate with `bunx web-push generate-vapid-keys`). Required
# together in production; keep the private key secret.
# All three must be set together, or all three left empty. A subject without
# the key pair fails env validation and the API refuses to start.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=

# Stateless optional-email unsubscribe links. Generate with:
#   openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=

# Account registration. Default is open. Use invite_only on private instances.
# SIGNUP_MODE=open

# Allow account creation without an email or social identity. Anonymous signup
# is available only while SIGNUP_MODE=open. Existing anonymous accounts can
# still be recovered after this is disabled.
# ENABLE_ANONYMOUS_AUTH=false

# Optional X (Twitter) OAuth. Use the OAuth 2.0 Client ID and Client Secret.
# Callback: {BETTER_AUTH_URL}/auth/callback/twitter
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# Optional generic OpenID Connect login. Configure all three required values
# together, or leave them empty. Callback:
#   {BETTER_AUTH_URL}/auth/oauth2/callback/{OIDC_PROVIDER_ID}
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL=
# OIDC_DISPLAY_NAME=SSO
# OIDC_PROVIDER_ID=oidc

# Background worker.
JOBS_ENABLED=true
JOBS_RECONCILIATION_CRON=*/30 * * * *
JOBS_NOTIFICATION_RECONCILE_CRON=*/15 * * * *
JOBS_MAX_CONCURRENCY=1
JOBS_POLLING_INTERVAL_SECONDS=60
JOBS_MAINTENANCE_POLLING_INTERVAL_SECONDS=300
JOBS_POOL_SIZE=8
JOBS_RETRY_LIMIT=5
JOBS_RETRY_BACKOFF_SECONDS=30
JOBS_RETENTION_SECONDS=604800
PGBOSS_SCHEMA=pgboss

# Worker health check thresholds. Readiness returns 503 when the oldest
# runnable notification.deliver job exceeds the lag threshold, or when
# non-terminal deliveries without a live transport job exceed the
# missing-transport threshold.
HEALTH_RUNNABLE_LAG_THRESHOLD_MS=900000
HEALTH_MISSING_TRANSPORT_THRESHOLD=10
