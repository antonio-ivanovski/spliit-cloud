DATABASE_URL=postgresql://postgres:1234@localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=postgres

PUBLIC_DEFAULT_CURRENCY_CODE=""
VITE_DEFAULT_CURRENCY_CODE=""
VITE_API_URL="http://localhost:3001"

# Local object storage (MaxIO)
PUBLIC_ENABLE_EXPENSE_DOCUMENTS=true
MAXIO_PORT=9000
MAXIO_ACCESS_KEY=maxioadmin
MAXIO_SECRET_KEY=maxioadmin
MAXIO_DEFAULT_BUCKETS=spliit-local
MAXIO_REGION=us-east-1
S3_UPLOAD_BUCKET=spliit-local
S3_UPLOAD_KEY=maxioadmin
S3_UPLOAD_SECRET=maxioadmin
S3_UPLOAD_REGION=us-east-1
S3_UPLOAD_ENDPOINT="http://localhost:9000"
S3_UPLOAD_PUBLIC_URL="http://localhost:9000/spliit-local"

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Spliit Cloud Local <no-reply@spliit.local>"

# Web Push (generate with `bunx web-push generate-vapid-keys`). Required
# together in production; keep the private key secret.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@yourdomain.com

# Stateless optional-email unsubscribe links. Generate with:
#   openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=

# Background worker.
JOBS_ENABLED=true
JOBS_RECONCILIATION_CRON=* * * * *
JOBS_MAX_CONCURRENCY=5
JOBS_POOL_SIZE=8
JOBS_RETRY_LIMIT=5
JOBS_RETRY_BACKOFF_SECONDS=30
JOBS_RETENTION_SECONDS=604800
PGBOSS_SCHEMA=pgboss

# Worker health check thresholds. Readiness returns 503 when the oldest
# runnable notification.deliver job exceeds the lag threshold, or when
# non-terminal deliveries without a live transport job exceed the
# missing-transport threshold.
HEALTH_RUNNABLE_LAG_THRESHOLD_MS=300000
HEALTH_MISSING_TRANSPORT_THRESHOLD=10
