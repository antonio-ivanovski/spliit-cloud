# syntax=docker/dockerfile:1

# The frontend `dist/` output is architecture-independent, so every
# compilation stage runs on the build platform (`$BUILDPLATFORM`). Only the
# final nginx stage varies per target platform. This lets a single
# multi-platform build run Vite once instead of once per architecture.
FROM --platform=$BUILDPLATFORM oven/bun:1.4.0-slim AS base
WORKDIR /app

FROM --platform=$BUILDPLATFORM base AS pruner
ARG APP_SCOPE=@spliit/web
COPY . .
RUN --mount=type=cache,target=/root/.bun/install/cache bunx turbo@2.10.7 prune "$APP_SCOPE" --docker

FROM --platform=$BUILDPLATFORM base AS installer
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/out/bun.lock ./bun.lock
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile

FROM --platform=$BUILDPLATFORM base AS builder
ARG VITE_API_URL
ARG VITE_DEFAULT_CURRENCY_CODE=USD
ARG VITE_STATUS_PAGE_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_DEFAULT_CURRENCY_CODE=$VITE_DEFAULT_CURRENCY_CODE
ENV VITE_STATUS_PAGE_URL=$VITE_STATUS_PAGE_URL
COPY --from=installer /app ./
COPY --from=pruner /app/out/full/ ./
RUN bun --filter @spliit/web build

FROM nginx:1.27-alpine AS web

COPY nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80/tcp
